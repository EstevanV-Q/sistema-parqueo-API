# Servidor API 
PORT=8080
ENV=development
LOG_LEVEL=info

# Dominio público y correo para TLS (Caddy)
APP_DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Base de datos MySQL (Docker Compose)
# El usuario, contraseña y base se toman de DB_USER/DB_PASS/DB_NAME (más abajo).
MYSQL_ROOT_PASSWORD=cambiar_contraseña_root_mysql

# Driver de base de datos: mysql (central) o sqlite (API de borde)
DB_DRIVER=mysql

# Conexión de la API central (Docker Compose usa estos mismos valores)
DB_HOST=localhost
DB_PORT=3306
DB_USER=parking_user
DB_PASS=cambiar_esta_contraseña_segura
DB_NAME=parking_db
DB_MAX_OPEN=25
DB_MAX_IDLE=25
DB_MAX_LIFE=5m

# API de borde: ruta del archivo SQLite local. El esquema se aplica al iniciar.
# SQLITE_PATH=./data/edge.db
# EDGE_SITE_ID=0123456789abcdef0123456789abcdef

# Sincronización borde -> central (opcional; vacío desactiva el worker)
# SYNC_URL=https://central.example.com/api/v1/sync/events
# SYNC_TOKEN=cambiar_token_de_sincronizacion_largo_y_aleatorio
# SYNC_INTERVAL=30s

#  Seguridad JWT (REQUERIDO en producción, sin valor por defecto inseguro) 
JWT_SECRET=cambiar_este_secreto_por_algo_largo_y_aleatorio_minimo_32_caracteres
JWT_ISSUER=parking-backend
JWT_AUDIENCE=parking-api
JWT_ACCESS=15m
JWT_REFRESH=72h

# CORS: orígenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost:3000

#  Zona horaria del sitio 
SITE_TIMEZONE=America/Bogota

# Tipo de vehículo por defecto para entradas automáticas LPR (código, no ID)
DEFAULT_VEHICLE_TYPE_CODE=car

#  Timeouts HTTP 
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

#  Datos de seed (solo desarrollo/local, NO usar en producción) 
SEED_ADMIN_PASSWORD=cambiar_contraseña_admin_minimo_12
SEED_OPERATOR_PASSWORD=cambiar_contraseña_operador_minimo_12
SEED_AUDITOR_PASSWORD=cambiar_contraseña_auditor_minimo_12
SEED_DEVICE_API_KEY=cambiar_clave_dispositivo_minimo_16
SEED_SITE_CODE=PLAZA-01
SEED_SITE_NAME=Centro Comercial Plaza
SEED_VEHICLE_PLATE=XYZ987

#  Bruno Collection Environment 
BASE_URL=http://localhost:8080
WS_URL=ws://localhost:8080
