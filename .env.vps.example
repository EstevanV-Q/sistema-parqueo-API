# Plantilla para desplegar la API en el VPS con panel administrativo.
# Copiar a .env y reemplazar los valores marcados con <...>.
# No guardar credenciales reales en este archivo.

PORT=8000
ENV=production
LOG_LEVEL=info

# Dominio público (sin puerto; el panel usa PORT=8000)
APP_DOMAIN=api-2.play.aetherpanel.es
ACME_EMAIL=admin@example.com

# Base de datos MySQL
DB_DRIVER=mysql
DB_HOST=<host-mysql>
DB_PORT=3306
DB_USER=<usuario-mysql>
DB_PASS=<contrasena-mysql>
DB_NAME=<nombre-base-de-datos>
DB_MAX_OPEN=25
DB_MAX_IDLE=25
DB_MAX_LIFE=5m

# Seguridad JWT: generar un secreto aleatorio de al menos 32 caracteres
JWT_SECRET=<secreto-aleatorio-minimo-32-caracteres>
JWT_ISSUER=parking-backend
JWT_AUDIENCE=parking-api
JWT_ACCESS=15m
JWT_REFRESH=72h

# CORS: incluir esquema; agregar el origen real del frontend si aplica
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost:3000,http://api-2.play.aetherpanel.es:8000,https://api-2.play.aetherpanel.es:8000

SITE_TIMEZONE=America/Bogota
DEFAULT_VEHICLE_TYPE_CODE=car

READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# Bruno / documentación
BASE_URL=http://api-2.play.aetherpanel.es:8000
WS_URL=ws://api-2.play.aetherpanel.es:8000

# Seed: solo para entornos de prueba. Si se usan, definir contraseñas fuertes.
# SEED_ADMIN_PASSWORD=<password-admin>
# SEED_OPERATOR_PASSWORD=<password-operador>
# SEED_AUDITOR_PASSWORD=<password-auditor>
# SEED_DEVICE_API_KEY=<api-key-dispositivo-minimo-16>
# SEED_SITE_CODE=PLAZA-01
# SEED_SITE_NAME=Centro Comercial Plaza
# SEED_VEHICLE_PLATE=XYZ987
